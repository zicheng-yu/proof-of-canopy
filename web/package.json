{
  "name": "proof-of-canopy-web",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:local": "node ../scripts/sync-web-data.ts --live 31337",
    "sync:deploy": "node ../scripts/sync-web-data.ts --auto",
    "dev": "npm run sync:local && vite",
    "serve": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run sync:deploy && npm run build && wrangler deploy"
  },
  "dependencies": {
    "h3-js": "^4.5.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.10"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  }
}
