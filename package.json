{
  "name": "proof-of-canopy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "forge build --root contracts",
    "test": "forge test --root contracts",
    "plots": "node scripts/prepare-plots.ts",
    "demo": "node scripts/demo.ts",
    "demo:local": "bash scripts/demo-local.sh",
    "demo:testnet": "node scripts/deploy.ts --verify && node scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "abis": "node scripts/export-abis.ts",
    "snapshot": "node scripts/snapshot-events.ts",
    "oracle": "node oracle/run.ts",
    "oracle:false-claim": "node oracle/stage-false-claim.ts TR-MANAVGAT-001 1 9400"
  },
  "dependencies": {
    "h3-js": "^4.5.0",
    "viem": "^2.57.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
