# Copy to .env for Base Sepolia runs (npm run demo:testnet). Never commit .env.
RPC_URL=https://sepolia.base.org

# Deployer is also the arbiter. It needs testnet ETH and tops up the other roles automatically.
DEPLOYER_KEY=
DEVELOPER_KEY=
# The funder also plays the challenger in the demo.
FUNDER_KEY=
VERIFIER_KEY=
ROGUE_VERIFIER_KEY=

# Etherscan v2 API key, used to verify contract source on Basescan. Optional.
ETHERSCAN_API_KEY=

# Optional overrides (ether / wei / seconds)
ESCROW_PER_PROJECT=0.02
VERIFIER_STAKE=10000000000000000
CHALLENGE_BOND=5000000000000000
CHALLENGE_WINDOW=60
