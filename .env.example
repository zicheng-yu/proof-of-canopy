# Copy to .env (never commit it). Used by npm run demo:testnet and the oracle.
RPC_URL=https://sepolia.base.org

# Deployer, also the arbiter. Either a raw key or an encrypted keystore (scrypt/aes-128-ctr, v3).
# It needs test ETH; the demo tops up the other role wallets from it.
DEPLOYER_KEY=
DEPLOYER_KEYSTORE=
DEPLOYER_PASSWORD_FILE=

DEVELOPER_KEY=
# The funder also plays the challenger in the demo.
FUNDER_KEY=
VERIFIER_KEY=
ROGUE_VERIFIER_KEY=

# Demo amounts (ether / wei / seconds)
ESCROW_PER_PROJECT=0.003
VERIFIER_STAKE=500000000000000
CHALLENGE_BOND=250000000000000
CHALLENGE_WINDOW=60
GAS_BUFFER=0.0003

# Sentinel-2 via Copernicus Data Space (OAuth client credentials) and NASA FIRMS
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
FIRMS_MAP_KEY=
